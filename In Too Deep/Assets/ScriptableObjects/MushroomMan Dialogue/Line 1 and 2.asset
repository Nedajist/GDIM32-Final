  m_Script: {fileID: 11500000, guid: 3c4e8aa789e15854daf4decdc27f321e, type: 3}
  m_Name: Line 1 and 2
  m_EditorClassIdentifier: 
  _lines:
  - "<i>The mushroom-being\u2019s skin is tinged with the light from far above. You
    wonder if its spores are affecting your mental faculties, or if you truly are
    in the presence of a perfect being.</i>"
  - '"I know what you are. You ought to have come from below. And I know what you
    seek. *That* thing."'
  _playerReplyOptions:
  - Yes (Lie)
  - Stay Silent (Lie)
  - No (Lie
